#!/bin/bash
if [ "${DIB_DEBUG_TRACE:-0}" -gt 0 ]; then
    set -x
fi
set -eu
set -o pipefail

match_sha256() {
    file=$1
    expected=$2
    if [ -z "$expected" ]; then
        echo "coast-controller: COAST_COOLIFY_INSTALLER_SHA256 is missing" >&2
        return 1
    fi
    if ! printf '%s\n' "$expected" | grep -Eq '^[0-9a-fA-F]{64}$'; then
        echo "coast-controller: checksum is not 64 hex characters" >&2
        return 1
    fi
    actual=$(sha256sum "$file" | awk 'NR==1 { print $1 }')
    actual=$(printf '%s' "$actual" | tr '[:upper:]' '[:lower:]')
    expected=$(printf '%s' "$expected" | tr '[:upper:]' '[:lower:]')
    if [ "$actual" != "$expected" ]; then
        echo "coast-controller: installer sha256 mismatch" >&2
        return 1
    fi
}

installer=${COAST_COOLIFY_INSTALLER:-${DIB_COAST_COOLIFY_INSTALLER:-}}
checksum=${COAST_COOLIFY_INSTALLER_SHA256:-${DIB_COAST_COOLIFY_INSTALLER_SHA256:-}}
if [ -z "$checksum" ]; then
    echo "coast-controller: COAST_COOLIFY_INSTALLER_SHA256 is missing" >&2
    exit 1
fi
if ! printf '%s\n' "$checksum" | grep -Eq '^[0-9a-fA-F]{64}$'; then
    echo "coast-controller: checksum is not 64 hex characters" >&2
    exit 1
fi
if [ -z "$installer" ]; then
    exit 0
fi
if [ ! -f "$installer" ]; then
    echo "coast-controller: installer is not a file" >&2
    exit 1
fi
if ! match_sha256 "$installer" "$checksum"; then
    exit 1
fi
sudo install -D -m 0750 "$installer" \
    "${TARGET_ROOT}/usr/lib/coast/coolify/install.sh"
