#!/bin/bash
if [ "${DIB_DEBUG_TRACE:-0}" -gt 0 ]; then
    set -x
fi
set -eu
set -o pipefail

# TODO(coast-agent): replace this copy step when coast/agent publishes
# a package name and a repository. Do not guess that location.
match_sha256() {
    file=$1
    expected=$2
    if [ -z "$expected" ]; then
        echo "coast-agent: COAST_AGENT_SHA256 is missing" >&2
        return 1
    fi
    if ! printf '%s\n' "$expected" | grep -Eq '^[0-9a-fA-F]{64}$'; then
        echo "coast-agent: checksum is not 64 hex characters" >&2
        return 1
    fi
    actual=$(sha256sum "$file" | awk 'NR==1 { print $1 }')
    actual=$(printf '%s' "$actual" | tr '[:upper:]' '[:lower:]')
    expected=$(printf '%s' "$expected" | tr '[:upper:]' '[:lower:]')
    if [ "$actual" != "$expected" ]; then
        echo "coast-agent: sha256 mismatch" >&2
        return 1
    fi
}

source_path=${COAST_AGENT_SOURCE:-${DIB_COAST_AGENT_SOURCE:-}}
checksum=${COAST_AGENT_SHA256:-${DIB_COAST_AGENT_SHA256:-}}
if [ -z "$source_path" ]; then
    exit 0
fi
case "$source_path" in
    http://*|https://*)
        if [ -z "$checksum" ]; then
            echo "coast-agent: COAST_AGENT_SHA256 is missing" >&2
            exit 1
        fi
        if ! printf '%s\n' "$checksum" | grep -Eq '^[0-9a-fA-F]{64}$'; then
            echo "coast-agent: checksum is not 64 hex characters" >&2
            exit 1
        fi
        exit 0
        ;;
esac
if [ ! -f "$source_path" ]; then
    echo "coast-agent: source is not a file" >&2
    exit 1
fi
if ! match_sha256 "$source_path" "$checksum"; then
    exit 1
fi
base=$(basename -- "$source_path")
sudo install -D -m 0640 "$source_path" \
    "${TARGET_ROOT}/tmp/coast-agent-payload/${base}"
