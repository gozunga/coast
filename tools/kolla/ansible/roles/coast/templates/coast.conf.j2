[DEFAULT]
transport_url = {{ rpc_transport_url }}
log_dir = /var/log/kolla/coast

[oslo_concurrency]
lock_path = /var/lib/coast/locks

[api]
bind_host = {{ api_interface_address }}
bind_port = {{ coast_api_listen_port }}
auth_strategy = keystone
api_paste_config = /etc/coast/api-paste.ini
public_endpoint = {{ coast_public_endpoint }}

[console]
bind_host = {{ api_interface_address }}
bind_port = {{ coast_console_listen_port | default(9610) }}
public_endpoint = {{ coast_console_public_endpoint | default('') }}
tls = {{ coast_console_tls | default('true') }}
token_ttl = {{ coast_console_token_ttl | default(60) }}

[secrets]
backend = {{ coast_secrets_backend }}
max_secret_bytes = {{ coast_max_secret_bytes }}

[database]
connection = {{ coast_database_connection }}{{ '?ssl_ca=' ~ openstack_cacert if database_enable_tls_internal | bool }}

[oslo_messaging_notifications]
transport_url = {{ notify_transport_url }}
{% if coast_enabled_notification_topics %}
driver = messagingv2
topics = {{ coast_enabled_notification_topics | map(attribute='name') | join(',') }}
{% else %}
driver = noop
{% endif %}

[oslo_messaging_rabbit]
use_queue_manager = true
processname = {{ item.key }}
heartbeat_in_pthread = {{ item.key == 'coast-api' }}
ssl = {{ om_enable_rabbitmq_tls | bool | lower }}
{% if om_enable_rabbitmq_tls | bool %}
ssl_ca_file = {{ om_rabbitmq_cacert }}
{% endif %}
rabbit_quorum_queue = true
{% if om_enable_rabbitmq_stream_fanout | bool %}
rabbit_stream_fanout = true
rabbit_qos_prefetch_count = {{ om_rabbitmq_qos_prefetch_count }}
{% endif %}
rabbit_transient_quorum_queue = true

[service_auth]
auth_type = password
auth_url = {{ keystone_internal_url }}
username = {{ coast_keystone_user }}
password = {{ coast_keystone_password }}
project_name = {{ coast_service_auth_project }}
project_domain_name = {{ coast_service_auth_domain }}
user_domain_name = {{ coast_service_auth_domain }}
cafile = {{ coast_openstack_cafile }}
insecure = false

# Limited user for agent-facing control-plane checks. Guests do not
# receive this section. Cloud clients stay on [service_auth].
[agent_auth]
auth_type = password
auth_url = {{ keystone_internal_url }}
username = {{ coast_agent_keystone_user }}
password = {{ coast_agent_keystone_password }}
project_name = {{ coast_service_auth_project }}
project_domain_name = {{ coast_service_auth_domain }}
user_domain_name = {{ coast_service_auth_domain }}
cafile = {{ coast_openstack_cafile }}
insecure = false

[keystone_authtoken]
www_authenticate_uri = {{ keystone_public_url }}
auth_url = {{ keystone_internal_url }}
auth_type = password
username = {{ coast_keystone_user }}
password = {{ coast_keystone_password }}
project_name = {{ coast_service_auth_project }}
project_domain_name = {{ coast_service_auth_domain }}
user_domain_name = {{ coast_service_auth_domain }}
cafile = {{ coast_openstack_cafile }}
insecure = false

region_name = {{ openstack_region_name }}
interface = internal
memcache_security_strategy = {{ memcache_security_strategy }}
memcache_secret_key = {{ memcache_secret_key }}
memcached_servers = {% for host in groups['memcached'] %}{{ 'api' | kolla_address(host) | put_address_in_context('memcache') }}:{{ memcached_port }}{% if not loop.last %},{% endif %}{% endfor %}

[controller_worker]
{% if coast_admin_ssh_key_name | length > 0 %}
admin_ssh_key_name = {{ coast_admin_ssh_key_name }}
{% endif %}
{% set worker_options = {
    'mgmt_netns': '',
    'health_manager_ips': coast_health_manager_ips | join(','),
    'driver': coast_driver,
    'enabled_drivers': coast_enabled_drivers | join(','),
    'agent_client_cert': '/etc/coast/certs/coast_client.cert-and-key.pem',
    'agent_client_key': '/etc/coast/certs/coast_client.cert-and-key.pem',
    'agent_client_ca': '/etc/coast/certs/coast_client_ca.cert.pem'
} | combine(coast_controller_worker_options) %}
{% for name, value in worker_options.items() %}
{{ name }} = {{ value }}
{% endfor %}

[certificates]
ca_certificate = /etc/coast/certs/coast_server_ca.cert.pem
ca_private_key = /etc/coast/certs/coast_server_ca.key.pem

{% for cloud_service in ['nova', 'neutron', 'cinder', 'glance', 'barbican', 'designate'] %}
[{{ cloud_service }}]
region_name = {{ coast_cloud_region }}
valid_interfaces = {{ coast_cloud_interface }}
ca_certificates_file = {{ coast_openstack_cafile }}
insecure = false

{% endfor %}
{% if item.key in ['coast-conductor', 'coast-console-proxy'] %}
# Agent certificate connections bind to the management address.
[health_manager]
bind_ip = {{ coast_health_manager_bind_ip }}

{% endif %}
{% if item.key == 'coast-health-manager' %}
[health_manager]
bind_ip = {{ coast_health_manager_bind_ip }}
bind_port = {{ coast_health_manager_port }}
key_lookup = {{ coast_health_manager_key_lookup }}
{% endif %}

{% if item.key == 'coast-conductor' and coast_coolify_build_registry_image_template | length > 0 %}
[coolify]
build_registry_image_template = {{ coast_coolify_build_registry_image_template }}

{% endif %}
{% if item.key == 'coast-conductor' %}
[export]
client_certificate = /etc/coast/certs/coast_client.cert-and-key.pem
client_key = /etc/coast/certs/coast_client.cert-and-key.pem
server_ca = /etc/coast/certs/coast_server_ca.cert.pem
{% endif %}
