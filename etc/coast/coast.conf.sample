# value)
#registry_image = registry:3@sha256:ddf754342cfc8acc51a56d5d0ab6af06826461864460636d8bd5c546dab2a7b8

# Seconds between private registry garbage collection on active stacks.
# (integer value)
# Minimum value: 1
#registry_gc_interval = 3600

# Conductor clientAuth certificate PEM file. (string value)
#agent_client_cert = <None>

# Conductor clientAuth private key PEM file. (string value)
#agent_client_key = <None>

# Coast client CA PEM file delivered to guest agents. (string value)
#agent_client_ca = <None>

# Health-manager management IPv4 addresses for guests. (list value)
#health_manager_ips =

