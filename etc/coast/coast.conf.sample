# Maximum seconds to wait for confirmed Cinder deletion. (integer value)
# Minimum value: 1
#volume_delete_timeout = 300

# Seconds between Cinder volume deletion checks. (integer value)
# Minimum value: 1
#volume_delete_poll_interval = 5

# Controller boot, volume, agent health and engine server validation timeout in
# seconds. (integer value)
# Minimum value: 1
#build_timeout = 900

# Controller provisioning poll interval in seconds. (integer value)
# Minimum value: 1
#build_poll_interval = 5

# Managed Docker volume size in GiB; conductor accounts for this capacity
# before Cinder creation. (integer value)
# Minimum value: 1
#docker_volume_size_gb = 20

# Accounted size in GiB for each named volume declared by a template service.
# (integer value)
# Minimum value: 1
#template_storage_gb = 1

# Managed Docker Cinder volume type. (string value)
#docker_volume_type = <None>

# Private registry volume size in GiB. The conductor accounts for this capacity
# before Cinder creation. The volume is attached only to the controller.
# (integer value)
# Minimum value: 1
#registry_volume_size_gb = 20

# Private registry Cinder volume type. (string value)
#registry_volume_type = <None>

# Private registry TCP port on the controller environment address. Security
# group rules use this same value. The registry accepts connections from the
