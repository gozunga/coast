[conductor]

#
# From coast
#

# Seconds between bounded service reconcile scan rounds. Rounds have up to ten
# percent jitter; failures back off up to one hour. No automatic restart is
# performed. (integer value)
# Minimum value: 1
#service_reconcile_interval = 600

# Number of conductor workers. (integer value)
#workers = 2

# Before a deployment goes ACTIVE, sample the container status this many times,
# stable_sample_interval apart. Any sample that is not running restarts the
# stability window, so a fast crash loop is not taken as stable. (integer
# value)
# Minimum value: 1
#stable_samples = 6

# Seconds between stability samples. (floating point value)
# Minimum value: 0
#stable_sample_interval = 2.0

# Seconds a container must run without a restart before a deployment or start
# becomes ACTIVE, or runtime reconcile recovers its own ERROR status. (integer
# value)
# Minimum value: 0
#stable_seconds = 20

# Deployment timeout in seconds. (integer value)
# Minimum value: 1
#deploy_timeout = 600

# Seconds of container crash loops after rollout, or HTTP no answer/502/503
# with an HTTP health check, before deployment failure or runtime reconcile
# ERROR. 0 disables this deadline; deploy_timeout remains the final limit.
# (integer value)
# Minimum value: 0
#deploy_unreachable_timeout = 150

# Before marking a started or deployed service ACTIVE, require apps with HTTP
# checks to answer below HTTP 500 at the worker floating IP. Disable when the
# conductor cannot reach worker floating IPs. (boolean value)
#http_check = true

# Seconds a started or restarted service may stay STARTING before it is marked
# ERROR. Checked by the deployment settle poll (settle_poll_interval). (integer
# value)
# Minimum value: 1
#start_timeout = 180

# Interval in seconds for deployment recovery. Startup also checks deployments.
# Unknown enqueue outcomes fail after deploy_timeout; they are never
# resubmitted. (integer value)
# Minimum value: 1
#deploy_reconcile_interval = 60

# Interval in seconds for checking DEPLOYING and STARTING services and moving
# them to ACTIVE, FAILED or ERROR. Only services in those states are checked.
# Export and snapshot housekeeping stay on deploy_reconcile_interval. (integer
# value)
# Minimum value: 1
#settle_poll_interval = 15

# Stack and server boot timeout in seconds. (integer value)
#build_timeout = 900


[console]

#
# From coast
#

# Address on which the console session service listens. (string value)
#bind_host = 0.0.0.0

# Console session listen port. (port value)
# Minimum value: 0
# Maximum value: 65535
#bind_port = 9610

# Public host and optional port for console session URLs, without a scheme.
# Example: console.example.com:9610. (string value)
#public_endpoint =

# Use wss in session URLs. Set false only when the public listener is not TLS.
# (boolean value)
#tls = true

# Seconds a console session token stays valid. (integer value)
# Minimum value: 1
#token_ttl = 60

# Seconds of no session data before the session closes. This is
# console_idle_timeout. (integer value)
# Minimum value: 1
#idle_timeout = 900

# Maximum session length in seconds. This is console_max_duration. (integer
# value)
# Minimum value: 1
#max_duration = 14400


